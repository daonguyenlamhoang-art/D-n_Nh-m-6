// ===============================================================
// NightFood - ERD Chung 13 Bảng (Chuẩn dbdiagram.io / DBML)
// Các bảng: users, addresses, categories, dishes, dish_options,
// carts, cart_items, orders, order_items, order_status_histories,
// vouchers, reviews, chat_messages
// ===============================================================

Table users {
  id int [pk, increment]
  full_name varchar(100)
  username varchar(50) [unique]
  phone varchar(10)
  password_hash varchar(255)
  role varchar(20) [default: 'customer']
  is_active boolean [default: true]
  created_at datetime
}

Table addresses {
  id int [pk, increment]
  user_id int [ref: > users.id]
  recipient_name varchar(100)
  phone varchar(10)
  address_line varchar(255)
  area varchar(100)
  is_default boolean [default: false]
}

Table categories {
  id int [pk, increment]
  name varchar(100) [unique, not null]
  sort_order int [default: 0]
  is_active boolean [default: true]
}

Table dishes {
  id int [pk, increment]
  category_id int [ref: > categories.id, not null]
  name varchar(150) [not null]
  description text
  price int [not null]
  image_url varchar(500)
  status varchar(20) [default: 'AVAILABLE', note: 'AVAILABLE (ĐANG BÁN), OUT_OF_STOCK (HẾT MÓN), HIDDEN (ẨN)']
  is_available boolean [default: true]
  is_active boolean [default: true]
  is_featured boolean [default: false]
  is_combo boolean [default: false]
  combo_items_json text
  created_at datetime
  updated_at datetime
}

Table dish_options {
  id int [pk, increment]
  dish_id int [ref: > dishes.id, not null]
  option_group varchar(50) [default: 'Topping']
  option_name varchar(100) [not null]
  extra_price int [default: 0]
  is_required boolean [default: false]
  max_select int [default: 1]
  is_active boolean [default: true]
}

Table carts {
  id int [pk, increment]
  user_id int [ref: > users.id]
  guest_token varchar(64) [unique]
  status varchar(20) [default: 'active']
  created_at datetime
  updated_at datetime
}

Table cart_items {
  id int [pk, increment]
  cart_id int [ref: > carts.id, not null]
  dish_id int [ref: > dishes.id, not null]
  dish_option_id int [ref: > dish_options.id]
  selected_options_json text
  note varchar(255)
  quantity int [default: 1]
}

Table vouchers {
  id int [pk, increment]
  code varchar(30) [unique, not null]
  discount_type varchar(20) [not null, note: 'fixed | percent']
  discount_value int [not null]
  min_order_amount int [default: 0]
  max_discount_amount int
  start_at datetime [not null]
  end_at datetime [not null]
  usage_limit int
  used_count int [default: 0]
  is_active boolean [default: true]
}

Table orders {
  id int [pk, increment]
  order_code varchar(30) [unique, not null]
  user_id int [ref: > users.id]
  guest_token varchar(64)
  address_id int [ref: > addresses.id]
  voucher_id int [ref: > vouchers.id]
  customer_name varchar(100) [not null]
  phone varchar(10) [not null]
  customer_email varchar(150)
  address varchar(255) [not null]
  area varchar(100) [default: 'Nội thành']
  note varchar(500)
  desired_delivery_time varchar(100)
  subtotal int [default: 0]
  shipping_fee int [default: 0]
  discount_amount int [default: 0]
  total_amount int [default: 0]
  payment_method varchar(30) [default: 'COD']
  payment_confirmed boolean [default: false]
  status varchar(30) [default: 'pending']
  created_at datetime
  updated_at datetime
}

Table order_items {
  id int [pk, increment]
  order_id int [ref: > orders.id, not null]
  dish_id int [ref: > dishes.id, not null]
  dish_option_id int [ref: > dish_options.id]
  dish_name varchar(150) [not null]
  option_name varchar(255)
  options_json text
  note varchar(255)
  quantity int [default: 1]
  unit_price int [default: 0]
  subtotal int [default: 0]
}

Table order_status_histories {
  id int [pk, increment]
  order_id int [ref: > orders.id, not null]
  changed_by int [ref: > users.id]
  old_status varchar(30)
  new_status varchar(30) [not null]
  note varchar(255)
  changed_at datetime
}

Table reviews {
  id int [pk, increment]
  order_id int [ref: > orders.id]
  user_id int [ref: > users.id]
  dish_id int [ref: > dishes.id, not null]
  customer_name varchar(100)
  rating tinyint [not null]
  comment text
  image_url varchar(500)
  store_reply text
  replied_at datetime
  is_visible boolean [default: true]
  created_at datetime
}

Table chat_messages {
  id int [pk, increment]
  user_id int [ref: > users.id]
  order_id int [ref: > orders.id]
  sender_type varchar(20) [not null, note: 'customer | admin']
  guest_token varchar(64)
  customer_name varchar(100)
  message text [not null]
  is_read boolean [default: false]
  created_at datetime
}
